+// SIDE-TASKBAR CELLS ARE SIZED FROM WHAT IS DRAWN. Measuring the native slot,
+// as the bottom and top taskbars do, counts padding that differs per item:
+// on 26300.9550 a side taskbar's WrapGrid pads only its FIRST slot (network,
+// 4px on the left), network and volume carry Windows' 4px inset around a 16px
+// glyph, and the battery glyph and percentage carry none. In a row that read
+// as gaps of roughly 1, 4 and 12px between the drawn icons. Instead every item
+// gets its drawn width plus the same inset on both sides, so the default
+// spacing is even and nudges are only for taste. Widths are sticky like
+// g_itemContentWidth and cleared with it - and on every edge change, since a
+// slot measured on one edge is padded differently on another.
+static constexpr double kNativeGlyphInset = 4.0;
+static double g_itemDrawnWidth[3]{};  // network, volume, battery glyph
+
+// Whether the current arrangement was laid out for a left or right taskbar:
+// a written arrangement is laid out exactly as written, while "auto" and the
+// block appended for unnamed items fill across the taskbar's WIDTH there, and
+// cells are sized from what is drawn (above). Set by AvailableOmniRows before
+// the layout is computed. UI thread only.
+static bool g_appliedSide = false;
+
+static void ForgetMeasuredWidths() {
+    for (double& width : g_itemContentWidth) width = 0.0;
+    for (double& width : g_itemDrawnWidth) width = 0.0;
+    g_remeasures = 0;
+}
