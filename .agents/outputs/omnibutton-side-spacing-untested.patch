+// The drawn element's own width, for side-taskbar cells. `owner` is the item's
+// native element; while it exists but its glyph has not been found yet, the
+// answer is "not yet" and the caller asks for another pass.
+static bool MeasureDrawnWidth(int item, FrameworkElement const& owner,
+                              FrameworkElement const& drawn) {
+    if (item < 0 || item > 2) return true;
+    if (g_itemDrawnWidth[item] > 0.0 || !owner) return true;
+    if (!drawn) return false;
+    double width = drawn.ActualWidth();
+    if (width <= 0.0) return false;
+    g_itemDrawnWidth[item] = std::ceil(width);
+    return true;
+}
